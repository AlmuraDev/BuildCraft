{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "decoration_type",
    "cases": [
      {
        "when": "destroy",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/destroy"
        }
      },
      {
        "when": "blueprint",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/blueprint"
        }
      },
      {
        "when": "template",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/template"
        }
      },
      {
        "when": "paper",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/paper"
        }
      },
      {
        "when": "leather",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/leather"
        }
      },
      {
        "when": "laser_back",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:item/decorated/laser_back"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "buildcraftcore:item/decorated/destroy"
    }
  }
}
