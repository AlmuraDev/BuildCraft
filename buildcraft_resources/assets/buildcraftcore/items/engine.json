{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "type",
    "cases": [
      {
        "when": "wood",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:block/engine/wood"
        }
      },
      {
        "when": "creative",
        "model": {
          "type": "minecraft:model",
          "model": "buildcraftcore:block/engine/creative"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "buildcraftcore:block/engine/wood"
    }
  }
}
